---
import { SITE } from '../config';
interface Props { variant?: 'footer' | 'inline'; id?: string }
const { variant = 'footer', id = 'nl' } = Astro.props;
const nl = SITE.newsletter;
const heading = variant === 'inline' ? 'Get the next part by email' : 'Get the next deep dive in your inbox';
---

<section class:list={['newsletter', variant]} aria-labelledby={`${id}-title`}>
  <div>
    <h2 id={`${id}-title`}>{heading}</h2>
    <p>
      {
        variant === 'inline'
          ? 'One email when a new part of the series is published. No spam, unsubscribe anytime.'
          : 'New research on the data & AI stack, roughly every week or two. No spam, unsubscribe anytime.'
      }
    </p>
  </div>
  {
    nl.enabled ? (
      <form action={nl.endpoint} method="post" class="nl-form" data-nl-form data-sitekey={nl.turnstileSiteKey}>
        <label for={`${id}-email`} class="sr-only">Email address</label>
        <input id={`${id}-email`} type="email" name="email" placeholder="you@company.com" required autocomplete="email" maxlength="254" />
        <button class="btn primary" type="submit">Subscribe</button>
        <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
        <input type="hidden" name="source" value={Astro.url.pathname} />
        <div class="ts" data-ts></div>
        <p class="nl-fine">Double opt-in: we'll email you a confirmation link. See the <a href="/privacy">privacy policy</a>.</p>
        <p class="nl-msg" role="status" aria-live="polite"></p>
      </form>
    ) : (
      <div class="nl-form">
        <a class="btn primary" href="/rss.xml">Follow via RSS</a>
        {SITE.social.youtube && <a class="btn" href={SITE.social.youtube} target="_blank" rel="noopener">YouTube</a>}
        {SITE.social.linkedin && <a class="btn" href={SITE.social.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
      </div>
    )
  }
</section>

<style>
  .newsletter {
    display: grid; grid-template-columns: 1.2fr 1fr; gap: 28px; align-items: center;
    padding: 30px 32px; border-radius: 18px; border: 1px solid var(--border);
    background:
      radial-gradient(600px 200px at 0% 0%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%),
      radial-gradient(500px 200px at 100% 100%, color-mix(in srgb, var(--accent-2) 14%, transparent), transparent 70%),
      var(--bg-elev);
  }
  h2 { margin: 0 0 6px; font-size: 22px; }
  p { margin: 0; color: var(--text-soft); font-size: 15px; }
  .nl-form { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; align-items: center; }
  input {
    flex: 1; min-width: 200px; font: 15px var(--font-sans); padding: 12px 14px; border-radius: 10px;
    border: 1px solid var(--border); background: var(--bg); color: var(--text);
  }
  input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .nl-msg { flex-basis: 100%; font-size: 14px; min-height: 0; font-weight: 600; }
  .nl-msg.err { color: var(--warn); }
  .nl-fine { flex-basis: 100%; font-size: 12.5px; color: var(--text-mute); }
  .nl-fine a { text-decoration: underline; }
  .ts:empty { display: none; }
  .ts { flex-basis: 100%; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .nl-msg:empty { display: none; }
  .inline { grid-template-columns: 1fr; gap: 16px; padding: 24px 26px; margin: 48px 0 0; }
  .inline h2 { font-size: 20px; margin-top: 0 !important; padding-top: 0 !important; }
  .inline .nl-form { justify-content: flex-start; }
  @media (max-width: 760px) { .newsletter { grid-template-columns: 1fr; padding: 24px; } .nl-form { justify-content: flex-start; } }
</style>

<script>
  // Background submit to our own /api/subscribe. Cloudflare Turnstile (bot check) loads only when a
  // reader starts typing, so normal page views load no third-party scripts.
  type TS = { render: (el: Element, o: Record<string, unknown>) => string; reset: (id: string) => void };
  declare global { interface Window { turnstile?: TS } }
  let tsLoad: Promise<TS> | null = null;
  const loadTurnstile = () =>
    (tsLoad ??= new Promise<TS>((resolve, reject) => {
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      s.async = true;
      s.onload = () => (window.turnstile ? resolve(window.turnstile) : reject(new Error('turnstile')));
      s.onerror = reject;
      document.head.appendChild(s);
    }));

  document.querySelectorAll<HTMLFormElement>('[data-nl-form]').forEach((form) => {
    const sitekey = form.dataset.sitekey;
    const msg = form.querySelector<HTMLElement>('.nl-msg')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const input = form.querySelector<HTMLInputElement>('input[type=email]')!;
    let widgetId: string | null = null;
    let token = '';
    let waiters: ((t: string) => void)[] = [];

    const start = async () => {
      if (!sitekey || widgetId !== null) return;
      widgetId = '';
      try {
        const ts = await loadTurnstile();
        widgetId = ts.render(form.querySelector('[data-ts]')!, {
          sitekey, appearance: 'interaction-only', action: 'subscribe',
          callback: (t: string) => { token = t; waiters.forEach((w) => w(t)); waiters = []; },
          'expired-callback': () => { token = ''; },
        });
      } catch { widgetId = null; }
    };
    input.addEventListener('focus', start, { once: true });
    input.addEventListener('input', start, { once: true });

    const getToken = () => new Promise<string>((resolve) => {
      if (!sitekey || token) return resolve(token);
      waiters.push(resolve);
      setTimeout(() => resolve(token), 15000);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.classList.remove('err');
      btn.disabled = true;
      msg.textContent = 'Subscribing…';
      try {
        await start();
        const t = await getToken();
        const body = new FormData(form);
        if (t) body.set('cf-turnstile-response', t);
        const res = await fetch(form.action, { method: 'POST', body, headers: { accept: 'application/json' } });
        const data = await res.json().catch(() => ({ ok: false, message: 'Something went wrong. Please try again.' }));
        msg.textContent = data.message;
        msg.classList.toggle('err', !data.ok);
        if (data.ok) input.value = '';
      } catch {
        msg.textContent = 'Network error — please try again.';
        msg.classList.add('err');
      } finally {
        btn.disabled = false;
        token = '';
        if (widgetId && window.turnstile) window.turnstile.reset(widgetId);
      }
    });
  });
</script>
