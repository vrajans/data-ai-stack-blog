---
import Figure from '../mdx/Figure.astro';
---

<Figure label="Apache Iceberg metadata tree: the catalog points to the current metadata.json, which lists snapshots; each snapshot has a manifest list pointing to manifests, which point to data files and delete files. Snapshot 2 reuses an unchanged manifest from snapshot 1." caption="Figure 2 — Inside an Iceberg table. A new snapshot writes only the new data files and manifests, and reuses everything unchanged. The commit is a single atomic pointer swap in the catalog.">
  <svg viewBox="0 0 960 470" xmlns="http://www.w3.org/2000/svg">
    <defs><marker id="ib-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" class="arrow"></path></marker>
    <marker id="ib-arr-a" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" class="arrow-a"></path></marker></defs>

    <text x="16" y="26" class="h">CATALOG</text>
    <text x="16" y="116" class="h">METADATA FILE</text>
    <text x="16" y="206" class="h">MANIFEST LISTS</text>
    <text x="16" y="296" class="h">MANIFESTS</text>
    <text x="16" y="392" class="h">FILES</text>

    <rect x="330" y="10" width="300" height="50" rx="10" class="box-b"></rect>
    <text x="480" y="32" text-anchor="middle" class="t tb" style="font-size:13.5px">db.orders → current metadata</text>
    <text x="480" y="50" text-anchor="middle" class="s">atomic compare-and-swap on commit</text>

    <line x1="560" y1="60" x2="600" y2="96" class="lna" marker-end="url(#ib-arr-a)"></line>
    <line x1="400" y1="60" x2="330" y2="96" class="ln dash" marker-end="url(#ib-arr)"></line>
    <text x="300" y="84" text-anchor="end" class="s">previous (v1)</text>

    <rect x="180" y="100" width="260" height="56" rx="10" class="box"></rect>
    <text x="310" y="124" text-anchor="middle" class="t" style="font-size:13px">v1.metadata.json</text>
    <text x="310" y="143" text-anchor="middle" class="s">schema · partition spec · snapshot S1</text>
    <rect x="520" y="100" width="300" height="56" rx="10" class="box-a"></rect>
    <text x="670" y="124" text-anchor="middle" class="t ta" style="font-size:13px">v2.metadata.json (current)</text>
    <text x="670" y="143" text-anchor="middle" class="s">schemas · specs · sort orders · S1, S2</text>

    <rect x="200" y="190" width="220" height="46" rx="10" class="box"></rect>
    <text x="310" y="218" text-anchor="middle" class="t" style="font-size:13px">snap-S1 manifest list</text>
    <rect x="560" y="190" width="220" height="46" rx="10" class="box-a"></rect>
    <text x="670" y="218" text-anchor="middle" class="t ta" style="font-size:13px">snap-S2 manifest list</text>
    <line x1="310" y1="156" x2="310" y2="186" class="ln" marker-end="url(#ib-arr)"></line>
    <line x1="670" y1="156" x2="670" y2="186" class="lna" marker-end="url(#ib-arr-a)"></line>

    <rect x="150" y="280" width="200" height="54" rx="10" class="box"></rect>
    <text x="250" y="303" text-anchor="middle" class="t" style="font-size:13px">manifest A</text>
    <text x="250" y="321" text-anchor="middle" class="s">files + column min/max stats</text>
    <rect x="420" y="280" width="200" height="54" rx="10" class="box"></rect>
    <text x="520" y="303" text-anchor="middle" class="t" style="font-size:13px">manifest B</text>
    <text x="520" y="321" text-anchor="middle" class="s">files + partition values</text>
    <rect x="690" y="280" width="200" height="54" rx="10" class="box-a"></rect>
    <text x="790" y="303" text-anchor="middle" class="t ta" style="font-size:13px">manifest C (new)</text>
    <text x="790" y="321" text-anchor="middle" class="s">added + delete files</text>

    <line x1="290" y1="236" x2="260" y2="276" class="ln" marker-end="url(#ib-arr)"></line>
    <line x1="330" y1="236" x2="500" y2="276" class="ln" marker-end="url(#ib-arr)"></line>
    <line x1="620" y1="236" x2="290" y2="276" class="lna dash" marker-end="url(#ib-arr-a)"></line>
    <line x1="660" y1="236" x2="530" y2="276" class="lna dash" marker-end="url(#ib-arr-a)"></line>
    <line x1="720" y1="236" x2="780" y2="276" class="lna" marker-end="url(#ib-arr-a)"></line>
    <text x="790" y="218" class="s ta" style="font-size:12px">reuses A + B, adds C</text>

    {[0, 1, 2, 3, 4, 5].map((i) => (
      <g>
        <rect x={146 + i * 112} y="372" width="104" height="40" rx="8" class={i >= 4 ? 'box-a' : 'box'}></rect>
        <text x={198 + i * 112} y="397" text-anchor="middle" class="s" style="font-family:var(--font-mono);fill:var(--text)">{i === 5 ? 'deletes (DV)' : `data-${i}.parquet`}</text>
      </g>
    ))}
    <line x1="230" y1="334" x2="210" y2="368" class="ln" marker-end="url(#ib-arr)"></line>
    <line x1="270" y1="334" x2="310" y2="368" class="ln" marker-end="url(#ib-arr)"></line>
    <line x1="500" y1="334" x2="420" y2="368" class="ln" marker-end="url(#ib-arr)"></line>
    <line x1="540" y1="334" x2="530" y2="368" class="ln" marker-end="url(#ib-arr)"></line>
    <line x1="770" y1="334" x2="640" y2="368" class="lna" marker-end="url(#ib-arr-a)"></line>
    <line x1="810" y1="334" x2="750" y2="368" class="lna" marker-end="url(#ib-arr-a)"></line>
    <text x="480" y="448" text-anchor="middle" class="s">Planning prunes at every level: partition summaries in the manifest list, then column stats in manifests, before any data file is opened.</text>
  </svg>
</Figure>
