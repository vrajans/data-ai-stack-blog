---
import Figure from '../mdx/Figure.astro';
---

<Figure label="Comparison of copy-on-write, where an update rewrites the whole data file, and merge-on-read, where an update writes a small delete marker and new rows that readers merge at query time until compaction." caption="Figure 4 — Copy-on-write pays at write time; merge-on-read pays at read time until compaction. Deletion vectors make the merge-on-read side much cheaper.">
  <svg viewBox="0 0 960 320" xmlns="http://www.w3.org/2000/svg">
    <defs><marker id="cm-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" class="arrow"></path></marker></defs>
    <text x="16" y="24" class="h">COPY-ON-WRITE</text>
    <rect x="16" y="38" width="190" height="60" rx="10" class="box"></rect>
    <text x="111" y="64" text-anchor="middle" class="t" style="font-size:13px">file-1.parquet</text>
    <text x="111" y="83" text-anchor="middle" class="s">1,000,000 rows</text>
    <text x="250" y="62" class="s" style="fill:var(--text)">UPDATE 3 rows</text>
    <line x1="210" y1="72" x2="380" y2="72" class="ln" marker-end="url(#cm-arr)"></line>
    <rect x="388" y="38" width="190" height="60" rx="10" class="box-w"></rect>
    <text x="483" y="64" text-anchor="middle" class="t" style="font-size:13px">file-1′.parquet</text>
    <text x="483" y="83" text-anchor="middle" class="s">all 1,000,000 rewritten</text>
    <foreignObject x="600" y="34" width="344" height="70"><div style="font:500 13px/1.45 var(--font-sans);color:var(--text-soft)"><b style="color:var(--text)">Writes:</b> slow, expensive for small changes.<br /><b style="color:var(--text)">Reads:</b> fastest — just scan clean files.</div></foreignObject>

    <line x1="16" y1="128" x2="944" y2="128" class="ln dash" style="opacity:.5"></line>

    <text x="16" y="156" class="h">MERGE-ON-READ</text>
    <rect x="16" y="170" width="190" height="60" rx="10" class="box"></rect>
    <text x="111" y="196" text-anchor="middle" class="t" style="font-size:13px">file-1.parquet</text>
    <text x="111" y="215" text-anchor="middle" class="s">unchanged</text>
    <text x="250" y="194" class="s" style="fill:var(--text)">UPDATE 3 rows</text>
    <line x1="210" y1="204" x2="380" y2="204" class="ln" marker-end="url(#cm-arr)"></line>
    <rect x="388" y="164" width="190" height="34" rx="8" class="box-a"></rect>
    <text x="483" y="186" text-anchor="middle" class="s" style="fill:var(--text)">deletion vector: rows 17, 42, 90</text>
    <rect x="388" y="204" width="190" height="34" rx="8" class="box-a"></rect>
    <text x="483" y="226" text-anchor="middle" class="s" style="fill:var(--text)">new file: 3 updated rows</text>
    <foreignObject x="600" y="160" width="344" height="80"><div style="font:500 13px/1.45 var(--font-sans);color:var(--text-soft)"><b style="color:var(--text)">Writes:</b> fast, tiny.<br /><b style="color:var(--text)">Reads:</b> engine skips deleted rows and adds new ones — slower as deltas pile up.</div></foreignObject>

    <rect x="16" y="258" width="928" height="48" rx="10" class="box-b"></rect>
    <text x="480" y="287" text-anchor="middle" class="t tb" style="font-size:13.5px">Compaction periodically folds deltas back into clean files — the maintenance you must schedule</text>
  </svg>
</Figure>
