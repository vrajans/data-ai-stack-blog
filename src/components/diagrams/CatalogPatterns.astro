---
import Figure from '../mdx/Figure.astro';
const W = 296, G = 20, X0 = 14;
const pats = [
  { t: 'A · One primary catalog', s: 'simplest; best default', engines: ['Spark', 'Trino', 'Warehouse'], cats: ['REST catalog'], note: 'All engines use one standards-based catalog. One policy model, one audit trail.' },
  { t: 'B · Platform catalogs + federation', s: 'multi-platform reality', engines: ['Databricks', 'Snowflake', 'Athena'], cats: ['Unity', 'Horizon', 'Glue'], note: 'Each platform keeps its catalog; federation or REST interop exposes shared tables across them.' },
  { t: 'C · Writer catalog, many readers', s: 'clear ownership', engines: ['Ingest jobs', 'BI engine', 'ML'], cats: ['Owner catalog'], note: 'One catalog owns writes for a domain; other platforms register the tables read-only.' },
];
---

<Figure label="Three catalog strategy patterns: one primary catalog for all engines; several platform catalogs connected by federation; and one writer catalog per domain with read-only access elsewhere." caption="Figure 3 — Three catalog strategies. Most organizations start with A, end up with some B, and use C to keep write ownership unambiguous.">
  <svg viewBox="0 0 960 330" xmlns="http://www.w3.org/2000/svg">
    {pats.map((p, i) => {
      const x = X0 + i * (W + G);
      const n = p.cats.length;
      return (
        <g>
          <rect x={x} y="10" width={W} height="310" rx="12" class="box" style="fill:var(--bg-elev)"></rect>
          <text x={x + 16} y="38" class="t" style="font-size:14.5px">{p.t}</text>
          <text x={x + 16} y="57" class="s">{p.s}</text>
          {p.engines.map((e, j) => (
            <g>
              <rect x={x + 16 + j * 90} y="74" width="84" height="34" rx="8" class="box"></rect>
              <text x={x + 58 + j * 90} y="96" text-anchor="middle" class="s" style="fill:var(--text);font-size:12px">{e}</text>
            </g>
          ))}
          {p.cats.map((c, j) => {
            const cw = n === 1 ? 264 : 84;
            const cx = n === 1 ? x + 16 : x + 16 + j * 90;
            return (
              <g>
                <rect x={cx} y="148" width={cw} height="38" rx="8" class={i === 2 && j === 0 ? 'box-a' : 'box-b'}></rect>
                <text x={cx + cw / 2} y="172" text-anchor="middle" class="s" style="fill:var(--text);font-size:12.5px;font-weight:600">{c}</text>
              </g>
            );
          })}
          {p.engines.map((_, j) => {
            const ex = x + 58 + j * 90;
            const tx = n === 1 ? x + 148 : ex;
            const dashed = i === 2 && j > 0;
            return <line x1={ex} y1="108" x2={tx} y2="146" class={dashed ? 'ln dash' : 'ln'}></line>;
          })}
          {i === 1 && <line x1={x + 58} y1="200" x2={x + 238} y2="200" class="lna dash"></line>}
          {i === 1 && <text x={x + 148} y="216" text-anchor="middle" class="s ta" style="font-size:11.5px">federation / REST interop</text>}
          {i === 2 && <text x={x + 148} y="210" text-anchor="middle" class="s" style="font-size:11.5px">solid = writes · dashed = reads</text>}
          <rect x={x + 16} y="228" width="264" height="22" rx="6" class="box-a"></rect>
          <text x={x + 148} y="243" text-anchor="middle" class="s" style="fill:var(--text);font-size:11.5px">open tables in object storage</text>
          <foreignObject x={x + 12} y="258" width={W - 24} height="58"><div style="font:500 12.5px/1.4 var(--font-sans);color:var(--text-soft)">{p.note}</div></foreignObject>
        </g>
      );
    })}
  </svg>
</Figure>
