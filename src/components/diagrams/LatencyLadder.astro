---
import Figure from '../mdx/Figure.astro';
const tiers = [
  { t: 'Batch', f: 'hours – a day', tech: 'scheduled ELT, dbt, Spark jobs', use: 'finance, planning, most BI', cost: 1, cls: 'box' },
  { t: 'Micro-batch', f: 'minutes', tech: 'CDC + incremental loads, Spark triggers', use: 'ops dashboards, inventory', cost: 2, cls: 'box-b' },
  { t: 'Streaming', f: 'seconds', tech: 'Kafka + Flink / Spark → lakehouse', use: 'alerts, live metrics, agent context', cost: 3, cls: 'box-a' },
  { t: 'Real-time', f: 'sub-second', tech: 'stream processing + real-time OLAP / online store', use: 'fraud, personalization, pricing', cost: 4, cls: 'box-w' },
];
const W = 222, G = 14, X0 = 12;
---

<Figure label="The latency ladder: batch (hours), micro-batch (minutes), streaming (seconds) and real-time (sub-second), with typical technologies, use cases and steadily increasing cost and operational complexity." caption="Figure 1 — The latency ladder. Each step up buys fresher data and costs more in always-on compute, state management and on-call effort. Climb only as far as the use case pays for.">
  <svg viewBox="0 0 960 330" xmlns="http://www.w3.org/2000/svg">
    <defs><marker id="ll-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" class="arrow"></path></marker></defs>
    {tiers.map((t, i) => {
      const x = X0 + i * (W + G);
      const top = 150 - i * 34;
      return (
        <g>
          <rect x={x} y={top} width={W} height={250 - top} rx="12" class={t.cls}></rect>
          <text x={x + 16} y={top + 28} class="t" style="font-size:16px">{t.t}</text>
          <text x={x + 16} y={top + 48} class="s" style="font-size:12.5px;fill:var(--text-soft)">freshness: {t.f}</text>
          <foreignObject x={x + 12} y={top + 58} width={W - 24} height="62"><div style="font:500 12px/1.4 var(--font-sans);color:var(--text-mute)">{t.tech}</div></foreignObject>
          <text x={x + 16} y="240" class="s" style="font-size:12px;fill:var(--text)">{t.use}</text>
          {[0, 1, 2, 3].map((k) => (
            <rect x={x + 16 + k * 22} y="266" width="18" height="10" rx="3" style={`fill:${k < t.cost ? 'var(--warn)' : 'var(--border)'}`}></rect>
          ))}
          <text x={x + 112} y="275" class="s" style="font-size:11.5px">cost &amp; complexity</text>
        </g>
      );
    })}
    <line x1="20" y1="306" x2="930" y2="306" class="ln" marker-end="url(#ll-arr)"></line>
    <text x="480" y="324" text-anchor="middle" class="s">fresher data  →  more always-on compute, state, and on-call</text>
  </svg>
</Figure>
