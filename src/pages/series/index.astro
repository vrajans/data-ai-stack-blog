---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/posts';
import { SERIES } from '../../series';

const posts = await getPosts();
---

<BaseLayout title="Series" description="Multi-part deep dives that walk through one layer of the data & AI stack end to end.">
  <section class="container">
    <header class="page-head">
      <p class="eyebrow">Series</p>
      <h1>Learn the stack, one series at a time</h1>
      <p>Each series is a structured path — read it in order, or jump to the part you need.</p>
    </header>
    <div class="list">
      {
        SERIES.map((s, i) => {
          const published = posts.filter((p) => p.data.series === s.slug).length;
          return (
            <a class="card series" href={`/series/${s.slug}`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h2>{s.title}</h2>
                <p>{s.description}</p>
              </div>
              <span class:list={['status', { live: published > 0 }]}>
                {published > 0 ? `${published} / ${s.parts.length} published` : 'Planned'}
              </span>
            </a>
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-head { margin: 56px 0 36px; max-width: 760px; }
  .eyebrow { color: var(--accent); font-weight: 650; font-size: 14px; letter-spacing: .06em; text-transform: uppercase; margin: 0; }
  h1 { font-size: clamp(32px, 5vw, 46px); margin: 8px 0 10px; }
  .page-head > p:not(.eyebrow) { color: var(--text-soft); margin: 0; }
  .list { display: grid; gap: 14px; }
  .series { display: grid; grid-template-columns: 56px 1fr auto; gap: 18px; align-items: center; padding: 22px 26px; }
  .num { font: 800 26px var(--font-display); color: var(--text-mute); }
  h2 { margin: 0 0 4px; font-size: 20px; }
  p { margin: 0; color: var(--text-soft); font-size: 15px; }
  .status { font-size: 13px; font-weight: 650; padding: 4px 10px; border-radius: 999px; background: var(--bg-soft); color: var(--text-mute); white-space: nowrap; }
  .status.live { background: var(--accent-soft); color: var(--accent-ink); }
  @media (max-width: 640px) { .series { grid-template-columns: 1fr; gap: 8px; } }
</style>
