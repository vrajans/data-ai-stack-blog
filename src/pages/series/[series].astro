---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, formatDate } from '../../lib/posts';
import { SERIES } from '../../series';

export async function getStaticPaths() {
  const posts = await getPosts();
  return SERIES.map((s) => ({ params: { series: s.slug }, props: { s, posts: posts.filter((p) => p.data.series === s.slug) } }));
}
const { s, posts } = Astro.props;
const byOrder = new Map(posts.map((p) => [p.data.seriesOrder ?? 0, p]));
---

<BaseLayout title={`${s.title} series`} description={s.description}>
  <section class="container narrow">
    <header class="page-head">
      <a class="eyebrow" href="/series">← All series</a>
      <h1>{s.title}</h1>
      <p>{s.description}</p>
    </header>
    <ol class="roadmap">
      {
        s.parts.map((part, i) => {
          const post = byOrder.get(i + 1);
          return (
            <li class:list={{ live: !!post }}>
              <span class="dot" aria-hidden="true">{i + 1}</span>
              <div class="body">
                {post ? (
                  <a href={`/blog/${post.id}`}><h2>{post.data.title}</h2></a>
                ) : (
                  <h2>{part.title}</h2>
                )}
                <p>{post ? post.data.description : part.summary}</p>
                <span class="state">{post ? `Published ${formatDate(post.data.pubDate)} · Read now →` : 'Coming soon'}</span>
              </div>
            </li>
          );
        })
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .narrow { max-width: 860px; }
  .page-head { margin: 56px 0 40px; }
  .eyebrow { color: var(--accent); font-weight: 650; font-size: 14px; }
  h1 { font-size: clamp(34px, 5vw, 48px); margin: 8px 0 10px; }
  .page-head p { color: var(--text-soft); margin: 0; font-size: 18px; }
  .roadmap { list-style: none; padding: 0; margin: 0; position: relative; }
  .roadmap::before { content: ''; position: absolute; left: 19px; top: 8px; bottom: 8px; width: 2px; background: var(--border); }
  li { position: relative; display: grid; grid-template-columns: 40px 1fr; gap: 20px; padding: 0 0 30px; }
  .dot { position: relative; z-index: 1; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center;
    font: 700 15px var(--font-display); background: var(--bg-soft); border: 2px solid var(--border); color: var(--text-mute); }
  li.live .dot { background: var(--accent); border-color: var(--accent); color: #fff; }
  h2 { margin: 6px 0 4px; font-size: 20px; }
  li:not(.live) h2 { color: var(--text-soft); }
  li.live a:hover h2 { color: var(--accent); }
  p { margin: 0; color: var(--text-soft); font-size: 15.5px; }
  .state { display: inline-block; margin-top: 8px; font-size: 13px; font-weight: 650; color: var(--text-mute); }
  li.live .state { color: var(--accent); }
</style>
