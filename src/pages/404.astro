---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="container nf">
    <p class="code">404</p>
    <h1>This page took a wrong turn in the pipeline.</h1>
    <p>The link may be broken or the article may have moved. Try searching, or head back home.</p>
    <div class="cta">
      <a class="btn primary" href="/">Go home</a>
      <button class="btn" type="button" data-open-search>Search articles</button>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { text-align: center; padding: 100px 20px 40px; max-width: 640px; }
  .code { font: 800 88px/1 var(--font-display); margin: 0; background: linear-gradient(100deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  h1 { font-size: 30px; }
  p { color: var(--text-soft); }
  .cta { display: flex; gap: 12px; justify-content: center; margin-top: 24px; }
</style>
