{
  "name": "data-ai-stack-blog",
  "version": "1.0.0",
  "description": "The Data & AI Stack \u2014 long-form research blog built with Astro",
  "scripts": {
    "dev": "node node_modules/astro/bin/astro.mjs dev",
    "build": "node node_modules/astro/bin/astro.mjs build && node node_modules/pagefind/lib/runner/bin.cjs --site dist",
    "preview": "node node_modules/astro/bin/astro.mjs preview",
    "new": "node scripts/new-post.mjs",
    "deploy": "node node_modules/wrangler/bin/wrangler.js deploy",
    "astro": "node node_modules/astro/bin/astro.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "pagefind": "^1.5.2",
    "wrangler": "^4.141.0"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
